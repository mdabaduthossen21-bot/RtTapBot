{
  "name": "rttapbot",
  "version": "1.0.0",
  "description": "Telegram Tap to Earn Bot",
  "main": "bot.js",
  "scripts": {
    "start": "node bot.js"
  },
  "dependencies": {
    "node-telegram-bot-api": "^0.66.0",
    "sqlite3": "^5.1.7",
    "express": "^4.19.2",
    "dotenv": "^16.4.5"
  }
}
const express = require('express');
const app = express();
const PORT = process.env.PORT || 3000;

app.get('/', (req, res) => {
  res.send('Bot is running alive!');
});

app.listen(PORT, () => {
  console.log(`Server is running on port ${PORT}`);
});
